---
import Base from '../../layouts/Base.astro';
import { copy, factIds } from '../../i18n/home';
import { LOCALES, HTML_LANG, site, type Lang } from '../../../site.config';
import { url } from '../../i18n/url';
import dims from '../../i18n/photos.json';
import SiteNav from '../../components/SiteNav.astro';
import SiteFooter from '../../components/SiteFooter.astro';

export function getStaticPaths() { return LOCALES.map((lang) => ({ params: { lang } })); }
const lang = Astro.params.lang as Lang;
const c = copy[lang];
const other: Lang = lang === 'en' ? 'zh-hant' : 'en';
const img = (n: string) => `${import.meta.env.BASE_URL}assets/img/${n}`.replace(/\/{2,}/g, '/');
// 照片：ID 對應 public/assets/img/credits.json。hero 是過渡用的替代照片，等使用者提供照片後換掉。
const pa = (name: string, sizes: string) => {
  const base = name.replace('.webp', '');
  const d = (dims as Record<string, { w: number; h: number }>)[name];
  const steps = [500, 960, 1280, 1920].filter((w) => w < d.w);
  const set = [...steps.map((w) => `${img(`${base}-${w}.webp`)} ${w}w`), `${img(name)} ${d.w}w`].join(', ');
  return { src: img(name), srcset: set, sizes, width: d.w, height: d.h };
};
const P = {
  hero: 'photo-f158008636.webp',
  indiana: 'photo-f19598734.webp',
  ut: 'photo-f52969256.webp',
  uf: 'photo-f10034341.webp',
  macau: 'photo-f14809678.webp',
  macauSign: 'photo-f199390693.webp',
  learn: 'photo-f33633818.webp',
  writing: 'photo-f1177377.webp',
  memories: 'photo-f131588403.webp',
};
const chapterImgs = [P.indiana, P.ut, P.uf, P.macau];
const nav = [['life', c.nav.life], ['work', c.nav.work], ['learn', c.nav.learn], ['writing', c.nav.writing], ['macau', c.nav.macau], ['memories', c.nav.memories]];
const diagramSpec = JSON.stringify({ layout: 'hub', alt: c.work.diagram.alt, center: { label: c.work.diagram.center }, spokes: c.work.diagram.spokes.map((label) => ({ label })) });
const arrow = `<svg class="m-arrow" viewBox="0 0 12 12" aria-hidden="true"><path class="m-arrow__stem" d="M1 6h8"/><path class="m-arrow__head" d="M4.5 2.5 8 6l-3.5 3.5"/></svg>`;
---
<Base lang={lang} title={c.title} description={c.description} path="">
  <SiteNav lang={lang} home />

  <main id="top" data-facts={factIds.join(',')}>
    <section class="hero hero--photo" data-enter data-calm="left" aria-labelledby="hero-h">
      <img class="hero__bg" {...pa(P.hero, '(max-width: 639px) 150vw, 100vw')} alt={c.hero.alt} data-source="commons" data-subject="landmark" style="--ly-pos: 50% 50%; --ly-pos-phone: 50% 50%" fetchpriority="high" />
      <div class="wrap"><div class="hero-text">
        <div class="hero__text">
          <h1 id="hero-h">{c.hero.h1}</h1>
          <p class="hero__lead">{c.hero.lead}</p>
          <div class="btn-row">
            <a class="btn btn--primary" href="#contact">{c.share}</a>
            <a class="btn btn--secondary" href="#life">{c.readLife}</a>
          </div>
        </div>
      </div></div>
    </section>

    <section class="section" id="life" data-moment="photo-chapters" aria-labelledby="life-h">
      <div class="wrap mo-ph">
        <div class="mo-ph__head"><h2 id="life-h">{c.life.h2}</h2><p>{c.life.lead} <a class="link" href={url(lang, 'life/#timeline')}>{c.more.life}</a></p></div>
        <ol class="mo-ph__list">
          {c.life.chapters.map((ch, i) => (
            <li class="mo-ph__ch">
              <figure class="mo-ph__pic"><img {...pa(chapterImgs[i], `(min-width: 1024px) 100vw, ${Math.ceil((dims as Record<string, { w: number; h: number }>)[chapterImgs[i]].w / (dims as Record<string, { w: number; h: number }>)[chapterImgs[i]].h * 165)}vw`)} alt={ch.alt} data-source="commons" data-subject="landmark" loading="lazy" /></figure>
              <h3>{ch.h}</h3>
              <p>{ch.p}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="section" id="work" style="--h: 1" aria-labelledby="work-h">
      <div class="wrap grid grid--middle">
        <div class="span-6">
          <div class="section-head"><h2 id="work-h">{c.work.h2}</h2><p>{c.work.lead} <a class="link" href={url(lang, 'works/')}>{c.more.work}</a></p></div>
          <ul class="rows">
            {c.work.items.map((it) => (
              <li><span class="rows__name">{it.name}</span><p>{it.text}</p>{it.value && <span class="rows__value">{it.value}</span>}</li>
            ))}
          </ul>
        </div>
        <div class="span-6 start-7">
          <div class="panel"><div class="dg" role="img" aria-label={c.work.diagram.alt} data-diagram={diagramSpec}></div></div>
        </div>
      </div>
    </section>

    <section class="section statement" id="idea" data-moment="word-highlight" aria-label={c.idea.label}>
      <div class="wrap">
        <p class="t-label">{c.idea.label}</p>
        <p class="mo-wh__text" role="group">{c.idea.before} <strong>{c.idea.strong}</strong>{c.idea.after}</p>
      </div>
    </section>

      <section class="section ground-surface" id="learn" style="--h: 1" aria-labelledby="learn-h">
      <div class="wrap grid grid--middle">
        <div class="span-6">
          <div class="section-head"><h2 id="learn-h">{c.learn.h2}</h2><p>{c.learn.lead}</p></div>
          <ul class="rows">
            {c.learn.items.map((it) => (
              <li><span class="rows__name">{it.name}</span><p>{it.text}</p><span class="rows__value">{it.value}</span></li>
            ))}
          </ul>
        </div>
        <figure class="pl-photo pl-photo--end span-6 start-7" style="--pl-r: .8"><img {...pa(P.learn, '(min-width: 1024px) 75vw, 170vw')} alt={c.learn.alt} data-source="commons" data-subject="stand-in" loading="lazy" /></figure>
      </div>
    </section>

    <section class="section ground-surface" id="writing" style="--h: 1" aria-labelledby="writing-h">
      <div class="wrap grid grid--middle">
        <div class="span-6">
          <div class="section-head"><h2 id="writing-h">{c.writing.h2}</h2><p>{c.writing.lead} <a class="link" href={url(lang, 'works/#browser')}>{c.more.writing}</a></p></div>
          <ul class="rows">
            {c.writing.items.map((it) => (
              <li><span class="rows__name"><a class="link" href={it.href} rel="noopener" target="_blank">{it.name}</a></span><p>{it.text}</p><span class="rows__value">{it.value}</span></li>
            ))}
          </ul>
        </div>
        <figure class="pl-photo pl-photo--end span-6 start-7" style="--pl-r: .62"><img {...pa(P.writing, '(min-width: 1024px) 75vw, 170vw')} alt={c.writing.alt} data-source="commons" data-subject="stand-in" loading="lazy" /></figure>
      </div>
    </section>

    <section class="section" id="macau" style="--h: 1" aria-labelledby="macau-h">
      <div class="wrap grid grid--middle">
        <div class="span-6">
          <div class="section-head"><h2 id="macau-h">{c.macau.h2}</h2><p>{c.macau.p}</p></div>
          <p class="t-lead">{c.macau.quote}</p>
        </div>
        <figure class="pl-photo pl-photo--end span-6 start-7" style="--pl-r: .8"><img {...pa(P.macauSign, '(min-width: 1024px) 75vw, 170vw')} alt={c.macau.signAlt} data-source="commons" data-subject="landmark" loading="lazy" /></figure>
      </div>
    </section>

    <section class="section" id="memories" style="--h: 1" aria-labelledby="memories-h">
      <div class="wrap grid grid--middle">
        <div class="span-6">
          <div class="section-head"><h2 id="memories-h">{c.memories.h2}</h2><p>{c.memories.p}</p></div>
        </div>
        <figure class="pl-photo pl-photo--end span-6 start-7" style="--pl-r: .8"><img {...pa(P.memories, '(min-width: 1024px) 75vw, 170vw')} alt={c.memories.alt} data-source="commons" data-subject="stand-in" loading="lazy" /></figure>
      </div>
    </section>
  </main>

  <SiteFooter lang={lang} home />
</Base>
