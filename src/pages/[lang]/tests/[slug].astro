---
import { getCollection, getEntry, render } from 'astro:content';
import Page from '../../../layouts/Page.astro';
import SourceRefs from '../../../components/SourceRefs.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import type { Lang } from '../../../../site.config';
import { url } from '../../../i18n/url';
import { wk } from '../../../i18n/pages';

export function getStaticPaths() {
  return (['zh-hant', 'en'] as const).flatMap((lang) => ['abas-3', 'ssq'].map((slug) => ({ params: { lang, slug } })));
}
const lang = Astro.params.lang as Lang;
const slug = Astro.params.slug as string;
const t = wk[lang];
const entry = await getEntry('pages', `${lang}/tests/${slug}`);
if (!entry) throw new Error(`Missing tests/${slug}`);
const { Content } = await render(entry);
const facts = new Map((await getCollection('facts')).map((f) => [f.id, f.data]));
const diagram = slug === 'abas-3'
  ? JSON.stringify({ layout: 'hub', alt: lang === 'en' ? 'The ABAS-3 groups adaptive skills into three domains: conceptual, social and practical.' : 'ABAS-3 把適應技能分成三個領域：概念、社會與實用。', center: { label: 'ABAS-3' }, spokes: (lang === 'en' ? ['Conceptual', 'Social', 'Practical'] : ['概念', '社會', '實用']).map((label) => ({ label })) })
  : null;
---
<Page lang={lang} title={entry.data.title} description={entry.data.description ?? ''} path={`tests/${slug}/`}>
  <div class="doc-block page-head">
    <div class="wrap"><div class="prose">
      <Breadcrumb label={lang === 'en' ? 'Breadcrumb' : '麵包屑'} items={[{ label: t.title, href: url(lang, 'works/') }, { label: entry.data.title }]} />
      <h1 class="t-h2" style="margin-top:24px">{entry.data.title}</h1>
      <div class="t-lead"><Content /></div>
    </div></div>
  </div>
  <div class="doc-block">
    <div class="wrap grid grid--top">
      <div class="span-6 prose">
        {entry.data.groups.map((g) => (
          <div class="fact-group">
            <h2>{g.title}</h2>
            <ul class="fact-list">
              {g.factIds.map((id) => <li>{facts.get(id)!.claim[lang]}<SourceRefs ids={facts.get(id)!.sourceIds} lang={lang} /></li>)}
            </ul>
          </div>
        ))}
      </div>
      {diagram && <div class="span-6 start-7"><div class="panel"><div class="dg" role="img" aria-label={JSON.parse(diagram).alt} data-diagram={diagram}></div></div></div>}
    </div>
  </div>
</Page>
