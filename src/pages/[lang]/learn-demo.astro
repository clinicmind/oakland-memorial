---
import { getEntry, render } from 'astro:content';
import Page from '../../layouts/Page.astro';
import QuizScript from '../../components/QuizScript.astro';
import '../../styles/learn.css';
import type { Lang } from '../../../site.config';
export function getStaticPaths() { return (['zh-hant', 'en'] as const).map((lang) => ({ params: { lang } })); }
const lang = Astro.params.lang as Lang;
const entry = await getEntry('fixtures', `${lang}/demo`);
if (!entry) throw new Error('missing demo fixture');
const { Content } = await render(entry);
---
<Page lang={lang} title={entry.data.title} description={entry.data.description ?? ''} path="learn-demo/" noindex ignoreSearch>
  <div class="doc-block page-head"><div class="wrap"><div class="prose"><h1 class="t-h2">{entry.data.title}</h1></div></div></div>
  <article class="doc-block unit"><div class="wrap"><div class="prose"><Content /></div></div></article>
  <QuizScript />
</Page>
