---
import Base from '../../layouts/Base.astro';
import SiteNav from '../../components/SiteNav.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import credits from '../../../public/assets/img/credits.json';
import { LOCALES, type Lang } from '../../../site.config';

export function getStaticPaths() { return LOCALES.map((lang) => ({ params: { lang } })); }
const lang = Astro.params.lang as Lang;
const t = {
  en: { title: 'Photograph credits', lead: 'Every photograph is from Wikimedia Commons under the licence shown. None shows Thomas D. Oakland. They stand in for his places until photographs with permission replace them.', by: 'by', licence: 'Licence', source: 'Source page' },
  'zh-hant': { title: '照片來源', lead: '所有照片都來自 Wikimedia Commons，授權如下。照片中沒有 Thomas D. Oakland。它們只是地點的替代照片，之後會換成取得授權的照片。', by: '攝影', licence: '授權', source: '來源頁面' },
}[lang];
const photos = (credits as { photos: { id: string; alt: string; by: string; licence: string; licenceUrl: string; page: string }[] }).photos;
---
<Base lang={lang} title={`${t.title} | Thomas D. Oakland`} description={t.lead} path="credits/">
  <SiteNav lang={lang} path="credits/" />
  <main id="main">
    <section class="section">
      <div class="wrap grid grid--top">
        <div class="span-8">
          <div class="section-head"><h1 class="t-h2">{t.title}</h1><p>{t.lead}</p></div>
          <ul class="rows">
            {photos.map((p) => (
              <li>
                <span class="rows__name"><a class="link" href={p.page} rel="noopener" target="_blank" lang="en">{p.alt}</a></span>
                <p lang="en">{t.by} {p.by}</p>
                <span class="rows__value"><a class="link" href={p.licenceUrl} rel="noopener" target="_blank">{p.licence}</a></span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter lang={lang} />
</Base>
