---
import { getCollection, getEntry, render } from 'astro:content';
import Page from '../../layouts/Page.astro';
import SourceRefs from '../../components/SourceRefs.astro';
import { MEMORY_FORM_URL, site, type Lang } from '../../../site.config';
import { ps } from '../../i18n/pages';
import { url } from '../../i18n/url';

// life、honors、places、sources：由 src/content/pages/<lang>/<slug>.md 產生。
export function getStaticPaths() {
  const slugs = ['life', 'honors', 'places', 'sources', 'macau', 'legacy', 'memories'];
  return (['zh-hant', 'en'] as const).flatMap((lang) => slugs.map((page) => ({ params: { lang, page } })));
}
const lang = Astro.params.lang as Lang;
const slug = Astro.params.page as string;
const t = ps[lang];
const entry = await getEntry('pages', `${lang}/${slug}`);
if (!entry) throw new Error(`Missing pages/${lang}/${slug}.md`);
const { Content } = await render(entry);
const facts = new Map((await getCollection('facts')).map((f) => [f.id, f.data]));
const sources = (await getCollection('sources')).sort((a, b) => Number(a.id.slice(1)) - Number(b.id.slice(1)));
const timeline = (await getCollection('timeline')).sort((a, b) => a.data.year - b.data.year || (a.data.month ?? 0) - (b.data.month ?? 0));
const longform = ['macau', 'legacy', 'memories'].includes(slug);
const kinds = [...new Set(timeline.map((x) => x.data.kind))];
---
<Page lang={lang} title={entry.data.title} description={entry.data.description ?? ''} path={`${slug}/`}>
  <div class="doc-block page-head">
    <div class="wrap">
      <div class="prose">
        <h1 class="t-h2">{entry.data.title}</h1>
        {!longform && <div class="t-lead"><Content /></div>}
      </div>
    </div>
  </div>

  {longform ? (
    <div class="doc-block">
      <div class="wrap">
        <div class="prose">
          <Content />
          {slug !== 'memories' && <p class="t-small" style="margin-top:32px">{lang === 'en' ? 'By ' : '撰文：'}{site.organizer[lang]}</p>}
          {slug === 'macau' && (
            <div class="fact-group" style="margin-top:48px">
              <h2>{lang === 'en' ? 'From the department newsletter' : '來自系刊'}</h2>
              <ul class="fact-list">
                <li>{facts.get('F16')!.claim[lang]}<SourceRefs ids={facts.get('F16')!.sourceIds} lang={lang} /></li>
              </ul>
            </div>
          )}
          {slug === 'memories' && (
            <p style="margin-top:32px">
              {MEMORY_FORM_URL
                ? <a class="btn btn--primary" href={MEMORY_FORM_URL} rel="noopener" target="_blank">{lang === 'en' ? 'Share a memory' : '分享回憶'}</a>
                : <span class="t-small">{lang === 'en' ? 'The sharing form opens soon.' : '投稿表單即將開放。'}</span>}
            </p>
          )}
        </div>
      </div>
    </div>
  ) : slug === 'sources' ? (
    <div class="doc-block">
      <div class="wrap">
        <table class="src-table">
          <thead><tr><th scope="col">{t.sourceCol}</th><th scope="col"></th><th scope="col">{t.checked}</th></tr></thead>
          <tbody>
            {sources.map((s) => (
              <tr id={s.id}>
                <th scope="row">{s.id}</th>
                <td>
                  <span lang="en">{s.data.title}</span><br />
                  {s.data.url ? <a href={s.data.url} rel="noopener" target="_blank" lang="en">{s.data.url}</a> : null}
                  {s.data.note ? <span class="t-small" style="display:block" lang="en">{s.data.note}</span> : null}
                </td>
                <td>{s.data.accessedOn ?? t.unopened}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  ) : (
    <div class="doc-block">
      <div class="wrap">
        <div class="prose">
          {entry.data.groups.map((g) => (
            <div class="fact-group">
              <h2>{g.title}</h2>
              <ul class="fact-list">
                {g.factIds.map((id) => {
                  const f = facts.get(id);
                  if (!f) throw new Error(`Unknown fact ${id}`);
                  return <li>{f.claim[lang]}<SourceRefs ids={f.sourceIds} lang={lang} />
                    {id === 'F29' && <> <a class="link" href="https://education.ufl.edu/news/2015/03/09/coe-responds-to-tragic-death-of-professor-emeritus-thomas-oakland/" rel="noopener" target="_blank" lang="en">{t.deathLink}</a></>}</li>;
                })}
              </ul>
            </div>
          ))}
        </div>
        {slug === 'life' && (
          <div id="timeline">
            <h2 class="t-h2" style="margin: 64px 0 24px">{t.timeline}</h2>
            <div class="tl-filters" role="group" aria-label={t.filter}>
              <button type="button" data-f="all" aria-pressed="true">{t.all}</button>
              {kinds.map((k) => <button type="button" data-f={k} aria-pressed="false">{t.kinds[k]}</button>)}
            </div>
            <ol class="tl">
              {timeline.map((x) => (
                <li data-c={x.data.kind}>
                  <div class="yr">{x.data.year}</div>
                  <div>
                    <div>{x.data.title[lang]}<SourceRefs ids={x.data.sourceIds} lang={lang} /></div>
                    <span class="kind">{t.kinds[x.data.kind]}</span>
                  </div>
                </li>
              ))}
            </ol>
            <script>
              const chips = document.querySelectorAll<HTMLButtonElement>('.tl-filters button');
              chips.forEach((c) => c.addEventListener('click', () => {
                chips.forEach((x) => x.setAttribute('aria-pressed', String(x === c)));
                document.querySelectorAll<HTMLElement>('.tl li').forEach((li) => { li.hidden = c.dataset.f !== 'all' && li.dataset.c !== c.dataset.f; });
              }));
            </script>
          </div>
        )}
      </div>
    </div>
  )}
</Page>
