---
import SourceBadge from './SourceBadge.astro';
import type { Lang } from '../../site.config';
interface Stat { value: string; label: string; sourceIds?: string[] }
interface Props { stats: Stat[]; label?: string; lang: Lang }
const { stats, label, lang } = Astro.props;
---
<div class="stats" role="group" aria-label={label}>
  <div class="wrap">
    {stats.map((s) => (
      <div class="stat"><b>{s.value}</b><span class="label">{s.label}</span>
        {s.sourceIds && <div class="meta">{s.sourceIds.map((id) => <SourceBadge id={id} lang={lang} />)}</div>}
      </div>
    ))}
  </div>
</div>
