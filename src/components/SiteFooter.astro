---
import { site, type Lang } from '../../site.config';
import { ui } from '../i18n/ui';
import { url } from '../i18n/url';
interface Props { lang: Lang }
const { lang } = Astro.props;
---
<footer class="site-footer">
  <div class="wrap">
    <p>{ui.footer.note[lang]}</p>
    <p>
      <a href={url(lang, 'sources/')}>{ui.footer.sources[lang]}</a> ·
      <a href={url(lang, 'about/')}>{ui.footer.about[lang]}</a> ·
      <a href={url(lang, 'about/#report')}>{ui.footer.report[lang]}</a>
    </p>
    <p>{site.organizer[lang]}</p>
  </div>
</footer>
