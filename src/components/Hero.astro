---
interface Props { eyebrow: string; name: string; roles?: string; lead?: string; portraitCaption: string; mono?: string }
const { eyebrow, name, roles, lead, portraitCaption, mono = '' } = Astro.props;
---
<div class="hero">
  <div class="wrap">
    <div>
      <div class="eyebrow">{eyebrow}</div>
      <h1>{name}</h1>
      {roles && <p class="roles">{roles}</p>}
      {lead && <p class="lead">{lead}</p>}
      <div class="cta"><slot name="cta" /></div>
    </div>
    <figure class="portrait">
      <span class="mono" aria-hidden="true">{mono}</span>
      <figcaption>{portraitCaption}</figcaption>
    </figure>
  </div>
</div>
