---
import { site, type Lang } from '../../site.config';
import { ui } from '../i18n/ui';
import { url } from '../i18n/url';
import LangSwitch from './LangSwitch.astro';
import MobileNav from './MobileNav.astro';
interface Props { lang: Lang; path?: string; current?: string }
const { lang, path = '', current } = Astro.props;
const items = [
  { key: 'life', path: 'life/' }, { key: 'works', path: 'works/' }, { key: 'learn', path: 'learn/' },
  { key: 'macau', path: 'macau/' }, { key: 'memories', path: 'memories/' },
] as const;
---
<header class="nav">
  <div class="wrap">
    <a class="brand" href={url(lang)}><small>In Memoriam</small>{site.person.name}</a>
    <nav aria-label={lang === 'en' ? 'Primary' : '主要導覽'}>
      {items.map((i) => <a href={url(lang, i.path)} aria-current={current === i.path ? 'page' : undefined}>{ui.nav[i.key][lang]}</a>)}
    </nav>
    <LangSwitch lang={lang} path={path} />
    <MobileNav lang={lang} items={[...items]} />
  </div>
</header>
