---
import '@fontsource-variable/albert-sans';
import '@fontsource/noto-sans-tc/400.css';
import '@fontsource/noto-sans-tc/500.css';
import { DEFAULT_LANG, HTML_LANG, LOCALES, PREVIEW, type Lang } from '../../site.config';
import { url } from '../i18n/url';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  path?: string;
  noindex?: boolean;
  ogImage?: string;
}
const { lang, title, description, path = '', noindex = false, ogImage } = Astro.props;
const a = (p: string) => `${import.meta.env.BASE_URL}assets/${p}`.replace(/\/{2,}/g, '/');
const zh = lang === 'zh-hant';
---
<!doctype html>
<!-- type: service. deal (fixed by docs/plan/DESIGN_SPEC.md section 2): palette cool-white-slate, type albert, radius soft,
     hero photo, nav nav-centre, footer footer-dark, close close-type, rhythm surface-pairs, buttons tonal, mark initial.
     moments: photo-chapters (#life), word-highlight (#idea). -->
<html lang={HTML_LANG[lang]} data-type="service" data-radius="soft" data-buttons="tonal" data-motion>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={a('favicon.svg')} type="image/svg+xml" />
    <meta name="theme-color" content="#f7f9fa" />
    <meta name="site-kind" content="other" />
    <meta name="page-type" content="service" />
    {/* 預覽期間全站 noindex。M11 使用者同意公開後，把 PREVIEW 改成 false。 */}
    {(PREVIEW || noindex) && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={new URL(url(lang, path), Astro.site).href} />
    <link rel="alternate" hreflang="x-default" href={new URL(url(DEFAULT_LANG, path), Astro.site).href} />
    {LOCALES.map((l) => <link rel="alternate" hreflang={HTML_LANG[l]} href={new URL(url(l, path), Astro.site).href} />)}
    <link rel="stylesheet" href={a('system.css')} />
    <link rel="stylesheet" href={a('ui/cards.css')} />
    <link rel="stylesheet" href={a('motion/motion.css')} />
    <link rel="stylesheet" href={a('layout/layout.css')} />
    <link rel="stylesheet" href={a('icons/icon.css')} />
    <link rel="stylesheet" href={a('ui/base.css')} />
    <link rel="stylesheet" href={a('diagrams/diagram.css')} />
    <style is:inline set:html={`:root {
  --p-bg: #f7f9fa; --p-surface: #ecf0f2; --p-ink: #1f3038; --p-muted: #5d6b72;
  --p-accent: #0d7480; --p-accent-ink: #ffffff; --p-action: #0d7480; --p-action-ink: #ffffff;
  --p-inv-bg: #1f3038; --p-inv-surface: #2c3c44; --p-inv-ink: #f7f9fa; --p-inv-muted: #9ea7ab;
  --p-inv-accent: #f7f9fa; --p-inv-accent-ink: #1f3038; --p-inv-action: #f7f9fa; --p-inv-action-ink: #1f3038;
  --font-display: "Albert Sans Variable", "Albert Sans", "Noto Sans TC", system-ui, sans-serif;
  --font-text: "Albert Sans Variable", "Albert Sans", "Noto Sans TC", system-ui, sans-serif;
  --display-weight: 400;
  --display-tracking: ${zh ? '0' : '-0.025em'};
  --display-tracking-xl: ${zh ? '0' : '-0.035em'};
}`} />
    <script is:inline>document.documentElement.classList.add('m-enter');setTimeout(()=>document.documentElement.classList.add('m-enter-done'),700)</script>
    <script is:inline>document.documentElement.classList.add('mo-js');setTimeout(()=>document.documentElement.classList.add('mo-safe'),2500)</script>
    <link rel="modulepreload" href={a('moments/moments.js')} />
    <link rel="modulepreload" href={a('moments/lib.js')} />
    <link rel="modulepreload" href={a('moments/photo-chapters/moment.js')} />
    <link rel="modulepreload" href={a('moments/word-highlight/moment.js')} />
  </head>
  <body>
    <slot />
    <script is:inline type="module" src={a('system.js')}></script>
    <script is:inline type="module" src={a('motion/motion.js')}></script>
    <script is:inline type="module" src={a('layout/layout.js')}></script>
    <script is:inline type="module" src={a('diagrams/mount.js')}></script>
  </body>
</html>
