---
import { HTML_LANG, LOCALES, site, type Lang } from '../../site.config';
interface Props { lang: Lang; title?: string; path?: string; noindex?: boolean }
const { lang, title, path = '', noindex = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const href = (l: string) => `${base}${l}/${path}`.replace(/\/\/+/g, '/');
const other = LOCALES.find((l) => l !== lang)!;
const pageTitle = title ? `${title} | ${site.title[lang]}` : site.title[lang];
---
<!doctype html>
<html lang={HTML_LANG[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {LOCALES.map((l) => <link rel="alternate" hreflang={HTML_LANG[l]} href={href(l)} />)}
  </head>
  <body>
    <header>
      <a href={href(lang)}>{site.title[lang]}</a>
      <a href={href(other)} hreflang={HTML_LANG[other]} lang={HTML_LANG[other]}>{other === 'en' ? 'English' : '繁體中文'}</a>
    </header>
    <main><slot /></main>
  </body>
</html>
